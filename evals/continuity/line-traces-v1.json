    {
      "id": "interval_downtime_and_cap",
      "split": "heldout",
      "title": "A promised interval survives downtime; oversized windows need a typed refusal",
      "steps": [
        {
          "at_hours": 0,
          "do": "open_line",
          "args": {
            "task": "Watch archive release notices",
            "promise": "Report every twenty minutes during the watch",
            "delivery": "when_needed",
            "window_hours": 1
          },
          "expect": {
            "same_line_id": true,
            "line_version": 1,
            "rows_active": 1
          }
        },
        {
          "at_hours": 1,
          "do": "run_due",
          "args": {},
          "expect": {
            "run_started": true,
            "run_read_version": 1,
            "same_line_id": true,
            "reply_sent": false
          }
        },
        {
          "at_hours": 1.17,
          "do": "run_due",
          "args": {
            "complete": false
          },
          "expect": {
            "run_started": true,
            "reply_sent": false
          }
        },
        {
          "at_hours": 1.5,
          "do": "restart",
          "args": {},
          "expect": {
            "same_line_id": true,
            "rows_active": 1
          }
        },
        {
          "at_hours": 1.51,
          "do": "finish_run",
          "args": {},
          "expect": {
            "run_read_version": 1,
            "same_line_id": true
          }
        },
        {
          "at_hours": 1.52,
          "do": "observe",
          "args": {
            "gap_reason": "A twenty-minute report slot skipped during downtime is still owed"
          },
          "expect": {
            "report_reason": "promised-report-due",
            "reply_sent": true
          },
          "gap": 813
        },
        {
          "at_hours": 1.67,
          "do": "run_due",
          "args": {},
          "expect": {
            "run_started": true,
            "report_reason": "promised-report-due",
            "reply_sent": true,
            "same_line_id": true
          }
        },
        {
          "at_hours": 2,
          "do": "replace_preparation",
          "args": {
            "goal": "Watch the archive for a full day at five-minute intervals",
            "window_hours": 24,
            "refusal_code": "invalid_window",
            "gap_reason": "A window with more than 96 slots needs a typed refusal rather than a silently capped promise"
          },
          "expect": {
            "run_started": false,
            "rows_active": 1,
            "same_line_id": true
          },
          "gap": 814
        },
        {
          "at_hours": 24,
          "do": "restart",
          "args": {},
          "expect": {
            "same_line_id": true,
            "line_version": 1
          }
        },
