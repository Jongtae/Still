{
  "version": "line-traces/1",
  "traces": [
    {
      "id": "standing_replacement_restart",
      "split": "dev",
      "title": "A standing correction survives replacement and restart into day two",
      "steps": [
        {
          "at_hours": 0,
          "do": "open_line",
          "args": {
            "task": "Review the reading queue each morning",
            "promise": "Send a daily reading summary"
          },
          "expect": {
            "same_line_id": true,
            "line_version": 1,
            "rows_active": 1
          }
        },
        {
          "at_hours": 1,
          "do": "run_due",
          "args": {},
          "expect": {
            "run_started": true,
            "run_read_version": 1,
            "same_line_id": true
          }
        },
        {
          "at_hours": 3,
          "do": "standing_correction",
          "args": {
            "owner_text": "From now on include unfinished items",
            "rule": "Include unfinished items"
          },
          "expect": {
            "line_version": 2,
            "same_line_id": true
          }
        },
        {
          "at_hours": 4,
          "do": "replace_preparation",
          "args": {
            "goal": "Group the reading queue by topic",
            "due_in_hours": 21
          },
          "expect": {
            "same_line_id": true,
            "rows_active": 1,
            "line_version": 2
          }
        },
        {
          "at_hours": 20,
          "do": "restart",
          "args": {},
          "expect": {
            "same_line_id": true,
            "line_version": 2,
            "rows_active": 1
          }
        },
        {
          "at_hours": 25,
          "do": "run_due",
          "args": {},
          "expect": {
            "same_line_id": true,
            "run_started": true,
            "run_read_version": 2,
            "rule_present": "Include unfinished items",
            "reply_sent": false
          }
        }
      ]
    },
