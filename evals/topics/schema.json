{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Still topic-page experiment artifacts",
  "oneOf": [
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/report" }
  ],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "share": { "type": "number", "minimum": 0, "maximum": 1 },
    "day": { "type": "string", "format": "date" },
    "itemId": { "type": "string", "pattern": "^i[0-9a-f]{8}$" },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "day", "source"],
      "properties": {
        "op": { "enum": ["add", "update"] },
        "day": { "$ref": "#/$defs/day" },
        "source": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "text", "quote", "source", "day", "history"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "section": { "enum": ["standard", "decision", "state"] },
        "text": { "type": "string", "minLength": 1 },
        "quote": { "type": ["string", "null"], "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "day": { "$ref": "#/$defs/day" },
        "thread": { "type": ["string", "null"], "minLength": 1 },
        "expires": { "anyOf": [{ "$ref": "#/$defs/day" }, { "type": "null" }] },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/history" }
        }
      },
      "if": { "properties": { "section": { "const": "standard" } } },
      "then": { "properties": { "quote": { "type": "string" } } }
    },
    "removed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "day", "source", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "day": { "$ref": "#/$defs/day" },
        "source": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_id", "name", "summary", "items"],
      "properties": {
        "topic_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "removed": { "type": "array", "items": { "$ref": "#/$defs/removed" } }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needed", "needed_weak", "essential", "misleading", "misleading_scored", "misleading_control",
        "misleading_weak", "traps", "traps_scored", "traps_control", "traps_weak", "misleading_other",
        "misleading_other_scored", "misleading_other_control", "misleading_other_weak",
        "lesson_present", "exploratory_follow", "characters", "downgraded"
      ],
      "properties": {
        "needed": { "$ref": "#/$defs/share" },
        "needed_weak": { "$ref": "#/$defs/share" },
        "essential": { "$ref": "#/$defs/share" },
        "misleading": { "type": "number", "minimum": 0 },
        "misleading_scored": { "type": "number", "minimum": 0 },
        "misleading_control": { "type": "number", "minimum": 0 },
        "misleading_weak": { "type": "number", "minimum": 0 },
        "traps": { "type": "number", "minimum": 0 },
        "traps_scored": { "type": "number", "minimum": 0 },
        "traps_control": { "type": "number", "minimum": 0 },
        "traps_weak": { "type": "number", "minimum": 0 },
        "misleading_other": { "type": "number", "minimum": 0 },
        "misleading_other_scored": { "type": "number", "minimum": 0 },
        "misleading_other_control": { "type": "number", "minimum": 0 },
        "misleading_other_weak": { "type": "number", "minimum": 0 },
        "lesson_present": { "$ref": "#/$defs/share" },
        "exploratory_follow": { "anyOf": [{ "$ref": "#/$defs/share" }, { "type": "null" }] },
        "characters": { "type": "number", "minimum": 0 },
        "downgraded": { "$ref": "#/$defs/count" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run", "judged", "judge_skipped", "drafts_skipped", "scored", "groups", "attached", "complete", "A", "B", "C"
      ],
      "properties": {
        "run": { "enum": [1, 2, 3] },
        "judged": { "$ref": "#/$defs/count" },
        "judge_skipped": { "$ref": "#/$defs/count" },
        "drafts_skipped": { "$ref": "#/$defs/count" },
        "scored": { "$ref": "#/$defs/count" },
        "attached": { "$ref": "#/$defs/count" },
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scored", "control", "weak"],
          "properties": {
            "scored": { "$ref": "#/$defs/count" },
            "control": { "$ref": "#/$defs/count" },
            "weak": { "$ref": "#/$defs/count" }
          }
        },
        "complete": { "type": "boolean" },
        "A": { "$ref": "#/$defs/metrics" },
        "B": { "$ref": "#/$defs/metrics" },
        "C": { "$ref": "#/$defs/metrics" },
        "D": { "$ref": "#/$defs/metrics" },
        "by_section": { "$ref": "#/$defs/bySection" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "applied", "refused", "calls"],
      "properties": {
        "run": { "enum": [1, 2, 3] },
        "applied": { "$ref": "#/$defs/count" },
        "calls": { "$ref": "#/$defs/count" },
        "refused": {
          "type": "object",
          "propertyNames": {
            "enum": ["bad_op", "missing_source", "unknown_source", "unknown_item",
                     "quote_not_verbatim", "rewrite", "judge_error", "retry_capped"]
          },
          "additionalProperties": { "$ref": "#/$defs/count" }
        }
      }
    },
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "range"],
      "properties": {
        "mean": { "type": "number", "minimum": 0 },
        "range": { "type": "number", "minimum": 0 }
      }
    },
    "aggregateMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needed", "needed_weak", "essential", "misleading", "misleading_scored", "misleading_control",
        "misleading_weak", "traps", "traps_scored", "traps_control", "traps_weak", "misleading_other",
        "misleading_other_scored", "misleading_other_control", "misleading_other_weak",
        "lesson_present", "exploratory_follow", "characters", "downgraded",
        "downgraded_total"
      ],
      "properties": {
        "needed": { "$ref": "#/$defs/spread" },
        "needed_weak": { "$ref": "#/$defs/spread" },
        "essential": { "$ref": "#/$defs/spread" },
        "misleading": { "$ref": "#/$defs/spread" },
        "misleading_scored": { "$ref": "#/$defs/spread" },
        "misleading_control": { "$ref": "#/$defs/spread" },
        "misleading_weak": { "$ref": "#/$defs/spread" },
        "traps": { "$ref": "#/$defs/spread" },
        "traps_scored": { "$ref": "#/$defs/spread" },
        "traps_control": { "$ref": "#/$defs/spread" },
        "traps_weak": { "$ref": "#/$defs/spread" },
        "misleading_other": { "$ref": "#/$defs/spread" },
        "misleading_other_scored": { "$ref": "#/$defs/spread" },
        "misleading_other_control": { "$ref": "#/$defs/spread" },
        "misleading_other_weak": { "$ref": "#/$defs/spread" },
        "lesson_present": { "$ref": "#/$defs/spread" },
        "exploratory_follow": { "anyOf": [{ "$ref": "#/$defs/spread" }, { "type": "null" }] },
        "characters": { "$ref": "#/$defs/spread" },
        "downgraded": { "$ref": "#/$defs/spread" },
        "downgraded_total": { "$ref": "#/$defs/count" }
      }
    },
    "interval": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "number", "minimum": -1, "maximum": 1 }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "ci95", "pairs"],
      "properties": {
        "mean": { "type": "number", "minimum": -1, "maximum": 1 },
        "ci95": { "$ref": "#/$defs/interval" },
        "pairs": { "$ref": "#/$defs/count" }
      }
    },
    "countDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "ci95", "pairs"],
      "properties": {
        "mean": { "type": "number" },
        "ci95": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "pairs": { "$ref": "#/$defs/count" }
      }
    },
    "callPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["find", "gold", "build", "build_retries", "drafts", "judge", "total"],
      "properties": {
        "find": { "$ref": "#/$defs/count" },
        "gold": { "$ref": "#/$defs/count" },
        "build": { "$ref": "#/$defs/count" },
        "build_retries": { "$ref": "#/$defs/count" },
        "drafts": { "$ref": "#/$defs/count" },
        "judge": { "$ref": "#/$defs/count" },
        "total": { "$ref": "#/$defs/count" }
      }
    },
    "locationCounts": {
      "type": "object",
      "required": ["standard", "decision", "state", "brief", "added", "none"],
      "propertyNames": { "enum": ["standard", "decision", "state", "brief", "added", "none"] },
      "additionalProperties": { "$ref": "#/$defs/count" }
    },
    "sectionMetrics": {
      "type": "object",
      "required": ["gained", "traps", "misleading_other"],
      "propertyNames": { "enum": ["gained", "traps", "misleading_other"] },
      "additionalProperties": { "$ref": "#/$defs/locationCounts" }
    },
    "bySection": {
      "type": "object",
      "required": ["A", "B", "C"],
      "propertyNames": { "enum": ["A", "B", "C", "D"] },
      "additionalProperties": { "$ref": "#/$defs/sectionMetrics" }
    },
    "decisionRevised": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrate", "reasons"],
      "properties": {
        "integrate": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "not_every_run_vs_a", "within_noise_vs_a", "ci_vs_a_includes_zero",
              "not_every_run_vs_c", "within_noise_vs_c", "ci_vs_c_includes_zero",
              "more_traps", "more_misleading_other"
            ]
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs", "builds", "gold_skipped", "aggregate", "paired_deltas", "decision", "decision_revised",
        "complete", "early_stop", "early_stop_ci_b_minus_a", "provisional", "plan", "budget"
      ],
      "properties": {
        "runs": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/run" } },
        "builds": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/build" } },
        "gold_skipped": { "$ref": "#/$defs/count" },
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B", "C"],
          "properties": {
            "A": { "$ref": "#/$defs/aggregateMetrics" },
            "B": { "$ref": "#/$defs/aggregateMetrics" },
            "C": { "$ref": "#/$defs/aggregateMetrics" },
            "D": { "$ref": "#/$defs/aggregateMetrics" }
          }
        },
        "paired_deltas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "B_minus_A", "C_minus_A", "B_minus_C", "B_minus_A_traps", "C_minus_A_traps", "B_minus_C_traps",
            "B_minus_A_misleading_other", "C_minus_A_misleading_other", "B_minus_C_misleading_other"
          ],
          "properties": {
            "B_minus_A": { "$ref": "#/$defs/delta" },
            "C_minus_A": { "$ref": "#/$defs/delta" },
            "B_minus_C": { "$ref": "#/$defs/delta" },
            "B_minus_A_traps": { "$ref": "#/$defs/countDelta" },
            "C_minus_A_traps": { "$ref": "#/$defs/countDelta" },
            "B_minus_C_traps": { "$ref": "#/$defs/countDelta" },
            "B_minus_A_misleading_other": { "$ref": "#/$defs/countDelta" },
            "C_minus_A_misleading_other": { "$ref": "#/$defs/countDelta" },
            "B_minus_C_misleading_other": { "$ref": "#/$defs/countDelta" },
            "D_minus_A": { "$ref": "#/$defs/delta" },
            "D_minus_C": { "$ref": "#/$defs/delta" },
            "B_minus_D": { "$ref": "#/$defs/delta" },
            "D_minus_A_traps": { "$ref": "#/$defs/countDelta" },
            "D_minus_C_traps": { "$ref": "#/$defs/countDelta" },
            "B_minus_D_traps": { "$ref": "#/$defs/countDelta" },
            "D_minus_A_misleading_other": { "$ref": "#/$defs/countDelta" },
            "D_minus_C_misleading_other": { "$ref": "#/$defs/countDelta" },
            "B_minus_D_misleading_other": { "$ref": "#/$defs/countDelta" }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrate", "reasons"],
          "properties": {
            "integrate": { "type": "boolean" },
            "reasons": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["not_every_run", "within_noise", "ci_includes_zero", "more_misleading", "search_not_worse"]
              }
            }
          }
        },
        "decision_revised": { "$ref": "#/$defs/decisionRevised" },
        "decision_ablation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["B", "D", "choice"],
          "properties": {
            "B": { "$ref": "#/$defs/decisionRevised" },
            "D": { "$ref": "#/$defs/decisionRevised" },
            "choice": { "enum": ["B", "D", null] }
          }
        },
        "by_section": { "$ref": "#/$defs/bySection" },
        "complete": { "type": "boolean" },
        "early_stop": { "type": "boolean" },
        "early_stop_ci_b_minus_a": { "anyOf": [{ "$ref": "#/$defs/interval" }, { "type": "null" }] },
        "provisional": { "type": "boolean" },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "works_before", "works_on_or_after", "replay_days", "heldout_candidates", "heldout_limit",
            "largest_judge_prompt_chars_approx", "projected_calls", "default_calls"
          ],
          "properties": {
            "works_before": { "$ref": "#/$defs/count" },
            "works_on_or_after": { "$ref": "#/$defs/count" },
            "replay_days": { "$ref": "#/$defs/count" },
            "heldout_candidates": { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
            "heldout_limit": { "$ref": "#/$defs/count" },
            "largest_judge_prompt_chars_approx": { "$ref": "#/$defs/count" },
            "projected_calls": { "$ref": "#/$defs/callPlan" },
            "expected_calls": { "$ref": "#/$defs/callPlan" },
            "default_calls": { "$ref": "#/$defs/callPlan" }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calls_by_route", "calls", "max_calls", "seconds", "claude_cost_usd"],
          "properties": {
            "calls_by_route": {
              "type": "object",
              "additionalProperties": false,
              "required": ["codex", "claude"],
              "properties": {
                "codex": { "$ref": "#/$defs/count" },
                "claude": { "$ref": "#/$defs/count" }
              }
            },
            "calls": { "$ref": "#/$defs/count" },
            "max_calls": { "$ref": "#/$defs/count" },
            "seconds": { "type": "number", "minimum": 0 },
            "claude_cost_usd": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
