{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "taxonomies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "licence": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "string",
            "minLength": 1
          },
          "depth": {
            "type": "string",
            "minLength": 1
          },
          "retrieval_note": {
            "type": "string",
            "minLength": 1
          },
          "retrieved": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "adopted",
              "considered-not-adopted-yet"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "publisher",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "adopted"
                }
              }
            },
            "then": {
              "required": [
                "id",
                "name",
                "publisher",
                "version",
                "url",
                "sha256",
                "licence",
                "attribution",
                "changes",
                "depth",
                "retrieved",
                "status"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "taxonomies"
  ],
  "additionalProperties": false
}
