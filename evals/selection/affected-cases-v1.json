  "rules": [
    {
      "id": "role-connector_effect",
      "match": {"propositions": ["connector_effect", "CONNECTOR_EFFECT_QUESTION"], "prompt_fragments": ["connector_effect"], "paths": ["src/personal_agent/prompts/connector_effect.md"]},
      "select": [{"set": "judgments", "roles": ["connector_effect"]}],
      "reason": "This instruction or proposition is exercised by the connector_effect judgment cases."
    },
    {
      "id": "role-press_effect",
      "match": {"propositions": ["PRESS_EFFECT_QUESTION"], "prompt_fragments": ["press_effect"], "paths": ["src/personal_agent/prompts/press_effect.md"]},
