      "reason": "This instruction or proposition is exercised by the connector_effect cases that carry a press target (#1066)."
    },
    {
      "id": "role-followup_relation",
      "match": {"propositions": ["followup_relation", "FOLLOWUP_QUESTION"], "prompt_fragments": ["followup_relation"], "paths": ["src/personal_agent/prompts/followup_relation.md"]},
