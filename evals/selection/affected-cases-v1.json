    {
      "id": "judgment-callers",
      "match": {"paths": ["src/personal_agent/conversation_handoff.py", "src/personal_agent/decision.py", "src/personal_agent/prompts/decision_system.md", "src/personal_agent/prompts/same_preparation_goal.md", "src/personal_agent/prompts/declined_preparation.md", "src/personal_agent/prompts/unsupported_capability.md", "src/personal_agent/prompts/capability_need.md", "src/personal_agent/prompts/turn_reaction.md", "src/personal_agent/prompts/closing_reaction.md", "src/personal_agent/prompts/memory_request.md", "src/personal_agent/prompts/memory_fact.md", "src/personal_agent/prompts/owner_stated_memory.md", "src/personal_agent/prompts/settings_request.md", "src/personal_agent/prompts/preparation_request.md", "src/personal_agent/prompts/watch_notify.md", "src/personal_agent/prompts/line_change.md", "src/personal_agent/prompts/watch_closed.md", "src/personal_agent/prompts/gap_instruction.md", "src/personal_agent/prompts/effect_reconciled.md", "src/personal_agent/prompts/owner_model_*.md"], "prompt_fragments": ["decision_system", "same_preparation_goal", "declined_preparation", "unsupported_capability", "capability_need", "turn_reaction", "closing_reaction", "memory_request", "memory_fact", "owner_stated_memory", "settings_request", "preparation_request", "watch_notify", "line_change", "watch_closed", "gap_instruction", "effect_reconciled", "owner_model_*"]},
      "select": [{"set": "judgments"}, {"set": "qualification"}],
      "reason": "Shared judgment instructions and callers affect all judgment roles and qualification definitions. Prompts without a dedicated case role conservatively use this shared judgment coverage."
    },
    {
      "id": "planner-catalogue",
      "match": {"paths": ["src/personal_agent/orchestrator.py"], "prompt_fragments": ["catalogue", "worker_catalogue"]},
      "select": [{"set": "judgments", "roles": ["orchestration_plan", "orchestration_escalation"]}, {"set": "scenarios"}],
      "reason": "Worker catalogue, planning and redelegation affect plan judgments and conversation outcomes."
    },
    {
      "id": "route-model-effort",
      "match": {"kinds": ["model", "route", "model-route", "effort"], "routes": ["*"], "paths": ["src/personal_agent/decision_routes.py", "src/personal_agent/cli_qualification.py", "src/personal_agent/providers.py", "src/personal_agent/decision_adapters.py", "src/personal_agent/subscription_engines.py"]},
      "select": [{"set": "judgments"}, {"set": "qualification"}, {"set": "scenarios"}],
      "reason": "A model, effort or route change can alter every judgment role on the configured route, qualification and worker outcomes; pin the model before comparing fastest_qualified arms."
    },
    {
      "id": "qualification-definitions",
      "match": {"paths": ["src/personal_agent/decision_qualification.py"], "propositions": ["PASS_THRESHOLD", "qualification-suite"], "prompt_fragments": ["qualification-suite"]},
      "select": [{"set": "qualification"}],
      "reason": "Qualification definitions and thresholds determine which candidate may qualify; compare suite fingerprints."
    },
    {
      "id": "worker-instructions",
      "match": {"paths": ["src/personal_agent/prompts/worker_*.md", "src/personal_agent/prompts/voice*.md", "src/personal_agent/prompts/native_search.md", "src/personal_agent/prompts/ask_or_assume.md", "src/personal_agent/agent_runtime.py", "src/personal_agent/prompts/day_plan*.md", "src/personal_agent/prompts/line_account.md", "src/personal_agent/prompts/prepared_legend.md", "src/personal_agent/prompts/code_run_library_hint.md", "src/personal_agent/prompts/effect_continuation.md", "src/personal_agent/prompts/revisable_records.md", "src/personal_agent/prompts/redelegation_carry.md", "src/personal_agent/prompts/memory_*.md"], "prompt_fragments": ["worker_*", "voice", "voice_calibration", "native_search", "ask_or_assume", "CORE_INSTRUCTIONS", "API_TOOL_GUIDANCE", "CLI_TOOL_GUIDANCE", "CLI_NATIVE_SEARCH_GUIDANCE", "GOAL_FIRST_GUIDANCE", "day_plan*", "line_account", "prepared_legend", "code_run_library_hint", "effect_continuation", "redelegation_carry", "memory_*"]},
      "select": [{"set": "scenarios"}, {"set": "judgments", "roles": ["goal_reached", "orchestration_escalation"]}],
      "reason": "Worker instructions can change final answers and outcome/redelegation judgments across synthetic scenarios."
    },
    {
      "id": "bundled-skill-instructions",
      "match": {"paths": ["skills/*/SKILL.md", "src/personal_agent/bundled_skills/*/SKILL.md"]},
      "select": [{"set": "scenarios"}, {"set": "judgments", "roles": ["goal_reached", "orchestration_escalation"]}],
      "reason": "Bundled skill content is loaded by the worker; changes select the same synthetic scenarios (including travel) and outcome/redelegation judgments as worker instructions."
    },
    {
      "id": "restated-contracts",
      "match": {"paths": ["docs/current-context-contract.en.md", "docs/professional-roles-and-communication-contract.en.md"]},
      "select": [{"set": "judgments", "roles": ["goal_reached", "orchestration_plan"]}],
      "reason": "These contracts are restated in the worker, planner and outcome prompts; edits require outcome and planning judgment regression coverage."
